<h2>Created events</h2>
<div id="created_events">
  <% @created_events.each do |event| %>
    <%= link_to "#{event.name}", event %>
    <br>
  <% end %>
</div>
<h2>Attended events</h2>
<div id="attended_events">
  
  <% upcoming_events, past_events = @user.attended_events.partition { |event| event.starts_on > Date.today } %>

  <h3>Upcoming events</h3>

  <% upcoming_events.each do |event| %>
    <%= link_to "#{event.name}", event %>
    <br>
  <% end %>

  <h3>Past events</h3>

  <% past_events.each do |event| %>
    <%= link_to "#{event.name}", event %>
    <br>
  <% end %>
</div>
