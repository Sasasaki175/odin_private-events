<p style="color: green"><%= notice %></p>

<%= render @event %>
<% if @event.creator == @user %>
  <%= link_to "Invite attendees", users_path(event_id: @event.id) %><br>
  <%= link_to "Edit event", edit_event_path(@event) %><br>
  <%= link_to "Delete event", @event, data: { turbo_method: :delete, turbo_confirm: "Delete #{@event.name}?" } %>
<% end %>
<h2>Attendees</h2>
<% @event.attendees.each do |attendee| %>
  <%= attendee.email %>
  <br>
<% end %>

<div>
  <%= link_to "Back to events", events_path %>
</div>
