<div>
  <p>
    <strong>Event:</strong>
    <%= event.name %>
  </p>

  <p>
    <strong>Location:</strong>
    <%= event.location %>
  </p>

  <p>
    <strong>Date:</strong>
    <%= event.starts_on %>
  </p>

  <p>
    <% if user_signed_in? %>
      <% if event.creator.id == @user.id %>
        <%= link_to "Invite attendees", users_path(event_id: event.id) %>
      <% else %>
        <%= render "signups/button", event: event, user: @user %>
      <% end %>
    <% else %>
      <%= link_to "Log in", new_user_session_path %> to attend event
    <% end %>
  </p>

</div>
