<div>
  <p>
    <strong>Event:</strong>
    <%= event.name %>
  </p>

  <p>
    <strong>Location:</strong>
    <%= event.location %>
  </p>

  <p>
    <strong>Date:</strong>
    <%= event.starts_on %>
  </p>

  <p>
    <% if user_signed_in? %>
      <%= render "signups/button", event: event %>
    <% else %>
      <%= link_to "Log in", new_user_session_path %> to attend event
    <% end %>
  </p>

</div>
